# ==================== 数据库 ====================
# MySQL 示例；如未安装 MySQL，可临时改为 sqlite:///./pet.db 体验
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/pet_db?charset=utf8mb4

# ==================== JWT 鉴权 ====================
# 生产环境务必替换为随机长字符串
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256

# ==================== 大模型（OpenAI 兼容协议）====================
# 兼容 DeepSeek / 通义 / 月之暗面 等任意 OpenAI 协议服务
DEEPSEEK_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_URL=https://api.deepseek.com
# 注意：需选择「支持 Function Calling」的模型，如 deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# ==================== Agent ====================
# 单轮对话最多允许的「工具调用 - 观察 - 再决策」步数，防止死循环
AGENT_MAX_STEPS=5
# 送入模型的最近历史消息条数
AGENT_HISTORY_LIMIT=12

# ==================== RAG ====================
RAG_TOP_K=4
RAG_MIN_SCORE=0.35
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ==================== 日志 ====================
LOG_LEVEL=INFO
