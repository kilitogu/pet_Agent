# 复制为 .env 后填写（docker compose 会自动读取这个文件）
# 注意：.env 已被 .gitignore 忽略，永远不要提交到仓库

# MySQL root 密码（自己改成一个强密码）
MYSQL_ROOT_PASSWORD=change-me-strong-password

# JWT 签名密钥（建议 32 位以上随机串）
JWT_SECRET_KEY=change-me-to-a-long-random-string

# DeepSeek API Key
DEEPSEEK_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 前端实际访问地址，用于后端 CORS 白名单，多个用英文逗号分隔
CORS_ORIGINS=http://localhost,http://your-server-ip

# nginx 对外端口
WEB_PORT=80
